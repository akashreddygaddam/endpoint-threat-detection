<group name="local,sysmon,endpoint_lab,">

<rule id="100101" level="12">

  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.commandLine" type="pcre2">(|-e\s+[A-Za-z0-9+/=]{20,})</field>

  <description>Encoded/obfuscated PowerShell command execution detected</description>

  <mitre>

    <id>T1059.001</id>

    <id>T1027</id>

  </mitre>

</rule>


<rule id="100102" level="15">

  <if_group>sysmon_event10</if_group>

  <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>

  <description>Process accessed LSASS memory - possible credential dumping</description>

  <mitre>

    <id>T1003.001</id>

  </mitre>

</rule>


<rule id="100103" level="10">

  <if_group>sysmon_event13</if_group>

  <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run</field>

  <description>Registry Run key modified - possible persistence mechanism</description>

  <mitre>

    <id>T1547.001</id>

  </mitre>

</rule>

</group>